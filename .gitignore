# Generated by setup.sh and build.sh. Contains third-party (copyrighted)
# files extracted from the original archives, and the XP key on the setup
# floppy; never commit these.
/VM/
/out/
# The original media (copyrighted, and the XP key); only the list and the
# empty folders (a hidden .gitkeep each, which the scripts skip) are kept.
/inputs/*
!/inputs/README.md
!/inputs/*/
/inputs/*/*
!/inputs/*/.gitkeep
__pycache__/
