; Unattended answer file for the Windows XP build guest (see docs/WINXP.md).
; setup.sh fills in @PRODUCTKEY@ and writes the result to a floppy
; image; XP Setup reads A:\WINNT.SIF when booting from the CD.
; Minimal: no optional components, no network adapter (QEMU gives it none).

[Data]
AutoPartition=1
MsDosInitiated="0"
UnattendedInstall="Yes"
AutomaticUpdates=No

[Unattended]
UnattendMode=FullUnattended
UnattendSwitch=Yes
OemSkipEula=Yes
OemPreinstall=No
TargetPath=\WINDOWS
Repartition=Yes
FileSystem=*
WaitForReboot=No
DriverSigningPolicy=Ignore
NonDriverSigningPolicy=Ignore
Hibernation=No

[GuiUnattended]
AdminPassword=*
EncryptedAdminPassword=No
AutoLogon=Yes
AutoLogonCount=9999
OEMSkipRegional=1
OemSkipWelcome=1
; Greenwich Standard Time: no daylight saving
TimeZone=90

[UserData]
ProductKey=@PRODUCTKEY@
FullName="Mod4Win"
OrgName=""
ComputerName=BUILDXP

[Identification]
JoinWorkgroup=WORKGROUP

[Networking]
InstallDefaultComponents=Yes

[RegionalSettings]
LanguageGroup=1
Language=00000409

[Display]
BitsPerPel=16
Xresolution=1024
YResolution=768
Vrefresh=60

[SystemRestore]
DisableSR=1

[Shell]
DefaultStartPanelOff=Yes
DefaultThemesOff=Yes

[Components]
AccessOpt=Off
Calc=Off
CharMap=Off
Chat=Off
Clipbook=Off
DeskPaper=Off
Dialer=Off
Fax=Off
Freecell=Off
Hearts=Off
HyperTerm=Off
IEAccess=Off
Media_Clips=Off
Media_Utopia=Off
Minesweeper=Off
MousePoint=Off
Msmsgs=Off
msnexplr=Off
MSWordPad=Off
OEAccess=Off
Paint=Off
Pinball=Off
Rec=Off
RootAutoUpdate=Off
Solitaire=Off
Spider=Off
TemplatesAccessOpt=Off
Vol=Off
WMAccess=Off
WMPOCM=Off
ZoneGames=Off

[GuiRunOnce]
Command0="cmd /c A:\FIRST.CMD"
