; MAKE.BAT, unchanged, run by DOSKEYS (build.sh). When a step fails,
; setup.exe asks for a key ("ERROR! press a key to abort", read from the
; keyboard, not from standard input); DOSKEYS presses it, as someone at the
; keyboard would, so a failing build ends instead of waiting. A question
; nobody should answer (copy's "Overwrite ...?", DOS's "Abort, Retry, Fail?")
; fails the build at once instead of running into the time limit.
cd F:\MOD4WIN
answer press a key to abort|ENTER
watch F:\BUILD.LOG
fail (Yes/No/All)
fail Abort, Retry, Fail
run cmd /c MAKE.BAT > F:\BUILD.LOG 2>&1
done
