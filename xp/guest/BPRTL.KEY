; Borland Pascal 7.01's run-time library source installer, into E:\BP\RTL.
; Run by DOSKEYS.
cd R:\BPRTL
run R:\BPRTL\INSTALL.EXE
wait Press ENTER to continue
key ENTER
wait Enter the SOURCE drive to use
key ENTER
wait Enter the SOURCE Path
key ENTER
wait Run-time library directory: R:\BP\RTL$
key ENTER
type E:\BP\RTL
key ENTER
wait Run-time library directory: E:\BP\RTL$
key F9
wait Press any key to continue
key ENTER
wait ESC=Exit
key ESC
done
