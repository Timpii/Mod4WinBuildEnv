; Borland Pascal 7.01's installer, as on the original machine: everything in
; E:\BP (MAKE.BAT's PATH has e:\bp, not \BP\BIN); Turbo Debugger and the
; Windows utilities (RC.EXE, used as e:\td\rc) in E:\TD. Run by DOSKEYS.
cd R:\BP
run R:\BP\INSTALL.EXE
wait Press ENTER to continue
key ENTER
wait Enter the SOURCE drive to use
key ENTER
wait Enter the SOURCE Path
key ENTER
wait Borland Pascal directory : R:\BP$
key ENTER
type E:\BP
key ENTER
wait Borland Pascal directory : E:\BP$
; Directory Options...
key DOWN DOWN DOWN DOWN DOWN DOWN DOWN DOWN ENTER
wait IDE/Command Line/Help : E:\BP\BIN$
key ENTER
type E:\BP
key ENTER
wait IDE/Command Line/Help : E:\BP$
; Turbo Debugger...
key DOWN DOWN DOWN DOWN ENTER
wait Turbo Debugger for DOS/DPMI : E:\BP\BIN$
key ENTER
type E:\TD
key ENTER DOWN ENTER
type E:\TD
key ENTER
wait Turbo Debugger for Windows : E:\TD$
key ESC
; Windows Tools...
wait Windows Tools...
key DOWN ENTER
wait Resource Workshop : E:\BP\BIN$
key ENTER
type E:\BP
key ENTER DOWN ENTER
type E:\BP
key ENTER DOWN ENTER
type E:\BP
key ENTER DOWN ENTER
type E:\BP
key ENTER DOWN ENTER
type E:\TD
key ENTER
wait Windows Utilities : E:\TD$
key ESC
; DOS Tools...
wait DOS Tools...
key DOWN ENTER
wait Turbo Assembler : E:\BP\BIN$
key ENTER
type E:\BP
key ENTER DOWN ENTER
type E:\BP
key ENTER DOWN ENTER
type E:\BP
key ENTER
wait Command-line utilities : E:\BP$
key ESC
wait Examples Programs...
key ESC
; Start Installation
wait Product Component Options...
key DOWN ENTER
wait To create the Program Manager group
key ENTER
wait Borland Pascal installation is now complete
key ENTER
; the README viewer
wait ESC=Exit
key ESC
done
